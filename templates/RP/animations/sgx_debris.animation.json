{
  "format_version": "1.8.0",
  "animations": {
    "animation.singularity.sgx_debris.spiral": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "v.r * math.cos(v.ang) * 16",
            "v.y * 16",
            "v.r * math.sin(v.ang) * 16"
          ],
          "scale": [
            "1 / math.sqrt(v.st)",
            "v.st",
            "1 / math.sqrt(v.st)"
          ],
          "rotation": [
            0,
            "-v.ang",
            "q.property('singularity:spin') * v.u"
          ]
        }
      }
    }
  }
}
