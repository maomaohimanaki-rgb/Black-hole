{
  "format_version": "1.21.0",
  "particle_effect": {
    "description": {
      "identifier": "singularity:sgx_p_ripple",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sgx/fx/ripple"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf.x"
      },
      "minecraft:particle_initial_speed": 0.0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.s.x + (v.s.y - v.s.x) * (v.particle_age / v.particle_lifetime)",
          "v.s.x + (v.s.y - v.s.x) * (v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            0,
            1,
            0.02
          ]
        },
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.c0.x",
          "v.c0.y",
          "v.c0.z",
          "math.clamp(v.a.x, 0, 1) * math.clamp(math.min(v.particle_age / v.lf.y, (v.particle_lifetime - v.particle_age) / v.lf.z), 0, 1)"
        ]
      }
    }
  }
}
