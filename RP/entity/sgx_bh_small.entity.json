{"format_version":"1.10.0","minecraft:client_entity":{"description":{"identifier":"singularity:sgx_bh_small","materials":{"add":"charged_creeper","flow":"charged_creeper","shadow":"entity_alphatest"},"textures":{"flow0":"textures/sgx/bh/flow0","flow1":"textures/sgx/bh/flow1","flow2":"textures/sgx/bh/flow2","flow3":"textures/sgx/bh/flow3","flow4":"textures/sgx/bh/flow4","static":"textures/sgx/bh/static"},"geometry":{"flow0":"geometry.singularity.sgx_bhs_flow0","flow1":"geometry.singularity.sgx_bhs_flow1","core":"geometry.singularity.sgx_bhs_core","shadow":"geometry.singularity.sgx_bhs_shadow"},"animations":{"face":"animation.singularity.sgx_bhs.face"},"scripts":{"pre_animation":["v.t = q.property('singularity:t0') + (math.floor(q.life_time * 20) + q.frame_alpha) / 20;","v.tk = v.t * 20;","v.bi = q.property('singularity:bin') == 0 ? 1 : math.abs(q.property('singularity:bin')) - 1;","v.below = q.property('singularity:bin') < 0;","v.cal = q.property('singularity:cal');","v.yaw = math.lerp(q.property('singularity:y0'), q.property('singularity:y1'), q.frame_alpha) - q.body_y_rotation + (math.mod(v.cal, 2) >= 1 ? 180 : 0);","v.ys = math.mod(math.floor(v.cal / 2), 2) >= 1 ? -1 : 1;","v.sx = math.mod(math.floor(v.cal / 4), 2) >= 1 ? -1 : 1;","v.sz = math.mod(math.floor(v.cal / 8), 2) >= 1 ? 1 : -1;","v.win = v.tk >= q.property('singularity:ts') && v.tk < q.property('singularity:te');","v.side = q.property('singularity:side');","v.born = v.side == 1 ? 20 : 40;","v.g = math.clamp((v.tk - v.born - 6) / 12, 0, 1);","v.grow = v.tk < v.born ? 0 : (v.g >= 1 ? 1 : 0.08 + 0.92 * (1 - math.pow(2, -10 * v.g)));","v.rs = v.side == 1 ? 1.63198 : 1.30866;","v.sc = v.tk >= 240 ? 0 : v.rs * v.grow;","v.on = v.win && v.tk >= v.born && v.tk < 240;","v.tau = math.max((240 - v.tk) / 20, 0.000001);","v.d = 28.0 * math.pow(v.tau / 9, 0.25);","v.ph = 360 * (35 / 48) * math.pow(9, 0.375) * 1.6 * (math.pow(9, 0.625) - math.pow(v.tau, 0.625));","v.a = v.side == 1 ? -0.44615385 * v.d : 0.55384615 * v.d;","v.fy = q.property('singularity:fyaw');","v.wx = v.a * (-math.cos(v.ph) * math.cos(v.fy) - math.sin(v.ph) * math.sin(v.fy));","v.wz = v.a * (-math.cos(v.ph) * math.sin(v.fy) + math.sin(v.ph) * math.cos(v.fy));","v.disk_off = !v.on;"],"animate":["face"]},"render_controllers":["controller.render.singularity.sgx_bhs_a_shadow","controller.render.singularity.sgx_bhs_core","controller.render.singularity.sgx_bhs_flow0","controller.render.singularity.sgx_bhs_flow1","controller.render.singularity.sgx_bhs_z_shadow"]}}}