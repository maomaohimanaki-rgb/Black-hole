{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec/audio_cues.json",
  "type": "object",
  "required": [
    "meta",
    "sounds"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "tick_rate",
        "film_ticks",
        "audio_end_tick"
      ]
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "tick",
          "end_tick",
          "volume",
          "pitch",
          "heard_in_cutscene",
          "heard_outside_cutscene",
          "channels",
          "onsets_intended",
          "recipe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sgx_[a-z0-9_]+$"
          },
          "file": {
            "type": "string",
            "pattern": "\\.ogg$"
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 800
          },
          "end_tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 800
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "pitch": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "heard_in_cutscene": {
            "type": "boolean"
          },
          "heard_outside_cutscene": {
            "type": "boolean"
          },
          "channels": {
            "type": "object",
            "properties": {
              "cutscene_2d": {
                "enum": [
                  "stereo",
                  "mono"
                ]
              },
              "positional_3d": {
                "enum": [
                  "mono",
                  null
                ]
              }
            }
          },
          "onsets_intended": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tick",
                "rms_norm"
              ],
              "properties": {
                "tick": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 800
                },
                "rms_norm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "centroid_hint_hz": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "recipe": {
            "type": "object",
            "required": [
              "type"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}